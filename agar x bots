import asyncio, time, random
import websockets
from protocol import (
    Reader, make_version, make_spawn, make_update, make_ping,
    parse_leaderboard, op_name,
)

class AgarClient:
    def __init__(self, ws_uri, nickname, proxy=None, auth_token="",
                 profile_name="aggressive", custom_name="", mimic_name="",
                 verbose=False):
        self.ws_uri = ws_uri
        self.nickname = custom_name or mimic_name or nickname
        self.mimic_name = mimic_name
        self.proxy = proxy
        self.auth_token = auth_token
        self.profile_name = profile_name
        self.verbose = verbose

        self.alive = False
        self.kicked = False
        self.reconnect_count = 0
        self.spawn_sent = False
        self.spawn_confirmed = False
        self.server_key = ""
        self.me = None
        self.nodes = {}
        self.leaderboard = []
        self.center = (0.0,0.0); self.radius = 1000.0
        self.last_ops = []   # ring of recent op codes for diagnostics

        self._ws = None; self._task = None; self._ping_task = None
        self._last_split=0.0; self._last_eject=0.0
        self._dead_since=None
        self._last_update=0.0
        self._update_jitter = random.uniform(0.060, 0.075)
        self.tick_hz=0.0; self._tick_count=0; self._tick_window=time.time()
        self.macro=None
        self._jitter_side = 1 if hash(nickname) % 2 else -1
        self._jitter_phase = random.uniform(0.3, 0.9)

    def _headers(self):
        h = {
            "Origin": "https://agar.io",
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                          "AppleWebKit/537.36 (KHTML, like Gecko) "
                          "Chrome/124.0 Safari/537.36",
            "Accept-Encoding": "gzip, deflate",
        }
        if self.auth_token:
            h["Cookie"] = f"auth_token={self.auth_token}"
        return h

    async def connect(self):
        # attach server key as query if present
        uri = self.ws_uri
        if self.server_key and "?" not in uri:
            uri = f"{uri}?key={self.server_key}"
        self._ws = await websockets.connect(
            uri, extra_headers=self._headers(), proxy=self.proxy,
            max_size=2**24, open_timeout=10, ping_interval=None,
        )
        await self._ws.send(make_version())
        await self._ws.send(make_spawn(self.nickname))
        self.spawn_sent = True
        self.kicked = False
        self._task = asyncio.create_task(self._read())
        self._ping_task = asyncio.create_task(self._ping_loop())

    async def _ping_loop(self):
        while self._ws:
            try:
                await self._ws.send(make_ping(int(time.time()*1000)))
            except Exception:
                return
            await asyncio.sleep(5.0)

    async def _read(self):
        try:
            async for msg in self._ws:
                if not isinstance(msg, bytes) or not msg: continue
                r = Reader(msg); op = r.u8()
                self.last_ops.append(op)
                if len(self.last_ops) > 32: self.last_ops.pop(0)
                if self.verbose:
                    print(f"[{self.nickname}] <- {op_name(op)} "
                          f"({len(msg)}B)")

                if op == 0x32:  # AddMyCell
                    cid = r.u32()
                    self.alive = True
                    self.spawn_confirmed = True
                    self.me = {"id": cid, "x":0.0, "y":0.0, "size":0.0}
                    self._dead_since = None
                    if self.verbose:
                        print(f"[{self.nickname}] SPAWN CONFIRMED id={cid}")

                elif op == 0x15:  # ClearMyCells
                    self.alive = False; self.me = None; self._dead_since = time.time()
                    if self.verbose:
                        print(f"[{self.nickname}] died")

                elif op == 0x14:
                    self.nodes.clear(); self.alive = False; self.me = None

                elif op == 0x20:  # AddNode
                    nid = r.u32()
                    if nid not in self.nodes:
                        x=r.u16(); y=r.u16(); size=r.u16()
                        cr=r.u8(); cg=r.u8(); cb=r.u8(); flags=r.u8()
                        try:
                            nm = r.str16()
                        except Exception:
                            nm = ""
                        self.nodes[nid]={"x":float(x),"y":float(y),
                                         "size":float(size),"flags":flags,
                                         "name":nm}

                elif op == 0x31:  # UpdatePos
                    nid = r.u32(); nx=float(r.i16()); ny=float(r.i16())
                    n = self.nodes.get(nid)
                    if n: n["x"]=nx; n["y"]=ny
                    if self.me and nid == self.me["id"]:
                        self.me["x"]=nx; self.me["y"]=ny

                elif op == 0x42: self.center = (r.f64(), r.f64())
                elif op == 0x41: self.radius = r.f64()
                elif op == 0x49: self.leaderboard = parse_leaderboard(r)

        except Exception:
            self.alive = False
            self.kicked = True

    async def respawn_if_dead(self):
        if self.alive or self._dead_since is None: return
        now = time.time()
        if now - self._dead_since < 1.2: return
        try:
            await self._ws.send(make_spawn(self.nickname))
            self._dead_since = now
        except Exception:
            self.alive = False; self.kicked = True

    def _jitter(self, tx, ty):
        if not self.me: return tx, ty
        mag = ((tx-self.me["x"])**2 + (ty-self.me["y"])**2) ** 0.5 or 1.0
        bow = (1 - self._jitter_phase) * mag * 0.12
        px = -(ty-self.me["y"])/mag * bow * self._jitter_side
        py =  (tx-self.me["x"])/mag * bow * self._jitter_side
        return tx+px, ty+py

    async def steer(self, tx, ty, want_split=False, want_eject=False, freeze=False):
        if not self._ws or not self.alive or not self.me: return
        if freeze: return
        tx, ty = self._jitter(tx, ty)
        dx = tx - self.me["x"]; dy = ty - self.me["y"]
        mag = (dx*dx + dy*dy)**0.5 or 1.0
        s = min(1.0, 500.0/mag)
        mx, my = int(dx*s), int(dy*s)
        now = time.time()
        split=0; eject=0
        if want_split and now - self._last_split > 1.2: split=1; self._last_split=now
        if want_eject and now - self._last_eject > 0.12: eject=1; self._last_eject=now
        if self.macro:
            act, ms, me_ = self.macro.tick(now)
            if ms: split=1
            if me_: eject=1
            if act is None and self.macro.t0 is None: self.macro=None
        try:
            await self._ws.send(make_update(mx, my, split, eject))
            self._tick_count += 1
            el = time.time() - self._tick_window
            if el >= 1.0:
                self.tick_hz = self._tick_count / el
                self._tick_count = 0; self._tick_window = time.time()
        except Exception:
            self.alive = False; self.kicked = True

    def fire_macro(self, name):
        from profiles import MACROS
        m = MACROS.get(name)
        if m: m.start(time.time()); self.macro = m

    async def close(self):
        for t in (self._task, self._ping_task):
            if t: t.cancel()
        try:
            if self._ws: await self._ws.close()
        except Exception:
            pass
'''

