"""agar.io protocol — spawn op is 0x00, name is UTF-16LE. That was the bug."""
import struct

C_PROTOCOL_VERSION = 0x01
C_SPAWN            = 0x00
C_UPDATE           = 0x03
C_PING             = 0x02

class Reader:
    __slots__ = ("b", "p")
    def __init__(self, buf): self.b = buf; self.p = 0
    def u8(self):  v = self.b[self.p]; self.p += 1; return v
    def u16(self): v = struct.unpack_from("<H", self.b, self.p)[0]; self.p += 2; return v
    def u32(self): v = struct.unpack_from("<I", self.b, self.p)[0]; self.p += 4; return v
    def i16(self): v = struct.unpack_from("<h", self.b, self.p)[0]; self.p += 2; return v
    def i32(self): v = struct.unpack_from("<i", self.b, self.p)[0]; self.p += 4; return v
    def f32(self): v = struct.unpack_from("<f", self.b, self.p)[0]; self.p += 4; return v
    def f64(self): v = struct.unpack_from("<d", self.b, self.p)[0]; self.p += 8; return v
    def str16(self):
        """UTF-16LE null-terminated string as agar.io uses for nicknames."""
        start = self.p
        while True:
            lo = self.b[self.p]; hi = self.b[self.p+1]
            self.p += 2
            if lo == 0 and hi == 0:
                return self.b[start:self.p-2].decode("utf-16-le", "replace")

def make_version(rev=0):
    return struct.pack("<BI", C_PROTOCOL_VERSION, rev)

def make_spawn(name: str):
    """0x00 + UTF-16LE name + 0x0000 terminator. THIS IS THE SPAWN."""
    out = bytearray([C_SPAWN])
    out += name.encode("utf-16-le")
    out += b"\x00\x00"
    return bytes(out)

def make_update(mx, my, split=0, eject=0, flags=0):
    """0x03 + int32 mx + int32 my + u8 split + u8 eject + u8 flags."""
    return struct.pack("<Bii BBB", C_UPDATE, mx, my, split, eject, flags)

def make_ping(ts=0):
    return struct.pack("<BI", C_PING, ts & 0xFFFFFFFF)

def parse_leaderboard(r):
    n = r.u32()
    out = []
    for _ in range(n):
        name = r.str16()
        uid  = r.u32()
        out.append((uid, name))
    return out

def op_name(op):
    return {
        0x10:"UpdateNodes", 0x14:"ClearAll", 0x15:"ClearMyCells",
        0x20:"AddNode", 0x31:"UpdatePos", 0x32:"AddMyCell",
        0x40:"Camera", 0x41:"SetRadius", 0x42:"SetCenter",
        0x49:"Leaderboard", 0x64:"SetBorder", 0xF0:"SetNickname",
    }.get(op, f"0x{op:02X}")
'''

