import asyncio, time
from agar_client import AgarClient
from profiles import profile, pick_name

class Fleet:
    def __init__(self, ws_uri, auth_token="", proxies=None,
                 target_uid=0, target_name="", profile_name="aggressive",
                 party_code="", mimic_name=False, trail_mode=False,
                 heal_mode=False, reconnect=True, verbose=False):
        self.ws_uri = ws_uri
        self.auth_token = auth_token
        self.proxies = [p for p in (proxies or []) if p.strip()] or [None]
        self.party_code = party_code
        self.target_uid = int(target_uid or 0)
        self.target_name = target_name
        self.locked_uid = None
        self.profile_name = profile_name
        self.mimic_name = mimic_name
        self.trail_mode = trail_mode
        self.heal_mode = heal_mode
        self.reconnect = reconnect
        self.verbose = verbose
        self.cursor = None
        self.freeze = False
        self.clients = {}
        self.order = []
        self._spawn_i = 0
        self._running = False
        self._task = None
        self.history = []
        self._last_snap = 0.0
        self.events = []

    async def _connect_with_backoff(self, c, tries=4):
        for i in range(tries):
            try:
                await c.connect()
                return True
            except Exception as e:
                if self.verbose: print(f"[fleet] connect fail {i}: {e}")
                idx = self.proxies.index(c.proxy) if c.proxy in self.proxies else 0
                c.proxy = self.proxies[(idx + 1) % len(self.proxies)]
                await asyncio.sleep(2 ** i)
        return False

    async def spawn_one(self, name=None, profile_name=None):
        pname = profile_name or self.profile_name
        nick = name or pick_name()
        bot_id = f"bt{self._spawn_i:02d}"
        self._spawn_i += 1
        proxy = self.proxies[len(self.clients) % len(self.proxies)]
        mimic = self.target_name if (self.mimic_name and self.target_name) else ""
        c = AgarClient(self.ws_uri, bot_id, proxy, self.auth_token,
                       profile_name=pname, custom_name=nick, mimic_name=mimic,
                       verbose=self.verbose)
        ok = await self._connect_with_backoff(c)
        if not ok:
            return f"spawn failed: {bot_id}"
        self.clients[bot_id] = c
        self.order.append(bot_id)
        if not self._task or self._task.done():
            self._running = True
            self._task = asyncio.create_task(self._loop())
        return f"spawned {bot_id} name={c.nickname} profile={pname} alive={c.alive}"

    async def spawn_many(self, n, profile_name=None, pad_names=None):
        out = []
        for i in range(n):
            nm = pad_names[i] if pad_names and i < len(pad_names) else None
            out.append(await self.spawn_one(name=nm, profile_name=profile_name))
            await asyncio.sleep(0.2)
        return out

    async def kill_one(self, name):
        c = self.clients.pop(name, None)
        if not c: return f"no bot {name}"
        if name in self.order: self.order.remove(name)
        await c.close(); return f"killed {name}"

    async def kill_all(self):
        for n in list(self.clients.keys()): await self.kill_one(n)
        return "killed all"

    def set_cursor(self, x, y): self.cursor = (float(x), float(y))

    def retarget(self, uid=0, name=""):
        self.target_uid = int(uid or 0); self.target_name = name; self.locked_uid = None

    def set_profile(self, name):
        self.profile_name = name
        for c in self.clients.values(): c.profile_name = name

    def fire_macro(self, m, bot_id=None):
        if bot_id and bot_id in self.clients:
            self.clients[bot_id].fire_macro(m)
        else:
            for c in self.clients.values(): c.fire_macro(m)

    def command(self, cmd):
        p = cmd.strip().split()
        if not p: return "empty"
        if p[0] == "all":
            if len(p) < 2: return "all what"
            if p[1] == "split": self.fire_macro("quad_split"); return "all split"
            if p[1] == "eject": self.fire_macro("fast_eject"); return "all eject"
            if p[1] == "stop": self.freeze = True; return "all stop"
            if p[1] == "go":   self.freeze = False; return "all go"
        if p[0].startswith("bt") and p[0] in self.clients and len(p) >= 2:
            c = self.clients[p[0]]
            if p[1] == "split": c.fire_macro("quad_split"); return f"{p[0]} split"
            if p[1] == "eject": c.fire_macro("fast_eject"); return f"{p[0]} eject"
            if p[1] == "profile" and len(p) > 2:
                c.profile_name = p[2]; return f"{p[0]} -> {p[2]}"
        if p[0] == "target" and len(p) > 1:
            self.retarget(0, " ".join(p[1:])); return f"target -> {' '.join(p[1:])}"
        return f"unknown: {cmd}"

    def _resolve_target(self):
        nodes = {}; lb = []
        for c in self.clients.values():
            if not c.alive: continue
            nodes.update(c.nodes)
            if c.leaderboard: lb = c.leaderboard; break
        if self.locked_uid is None:
            for uid, name in lb:
                if self.target_uid and uid == self.target_uid:
                    self.locked_uid = uid; break
                if not self.target_uid and self.target_name and name == self.target_name:
                    self.locked_uid = uid; break
        if self.locked_uid: return nodes.get(self.locked_uid)
        if self.cursor: return {"x": self.cursor[0], "y": self.cursor[1], "size":0.0}
        return None

    def _pick_food(self, c, radius=600.0):
        if not c.me: return None
        mx, my = c.me["x"], c.me["y"]
        foods = [n for n in c.nodes.values() if n["size"] < 20 and n["size"] > 0]
        if not foods: return None
        best=None; best_s=-1
        for f in foods[:50]:
            d = ((f["x"]-mx)**2 + (f["y"]-my)**2) ** 0.5
            if d > radius: continue
            neigh = sum(1 for g in foods if abs(g["x"]-f["x"])<120 and abs(g["y"]-f["y"])<120)
            score = neigh / (d + 50)
            if score > best_s: best_s = score; best = f
        return best

    async def _loop(self):
        while self._running and self.clients:
            await asyncio.sleep(0.066)
            now = time.time()
            target = self._resolve_target()

            if self.reconnect:
                for c in list(self.clients.values()):
                    if c.kicked:
                        ok = await self._connect_with_backoff(c)
                        if ok: c.kicked = False; self._event(f"reconnect: {c.nickname}")

            for i, bid in enumerate(list(self.order)):
                c = self.clients.get(bid)
                if not c: continue
                await c.respawn_if_dead()
                if not c.alive or not c.me: continue
                if self.freeze:
                    await c.steer(c.me["x"], c.me["y"], freeze=True); continue
                prof = profile(c.profile_name)

                if self.heal_mode and prof["eject_rate"] > 0 and i > 0:
                    leader = self.clients.get(self.order[0])
                    if leader and leader.me and c.me["size"] > 80:
                        d = ((leader.me["x"]-c.me["x"])**2+(leader.me["y"]-c.me["y"])**2)**0.5
                        if d < c.me["size"]*3:
                            await c.steer(leader.me["x"], leader.me["y"], want_eject=True); continue

                if self.trail_mode and i > 0:
                    prev = self.clients.get(self.order[i-1])
                    if prev and prev.me:
                        await c.steer(prev.me["x"], prev.me["y"]); continue

                if prof["flee_radius"] > 0:
                    danger = None
                    for n in c.nodes.values():
                        if n["size"] <= c.me["size"]*1.2: continue
                        d = ((n["x"]-c.me["x"])**2+(n["y"]-c.me["y"])**2)**0.5
                        if d < prof["flee_radius"]: danger = n; break
                    if danger:
                        await c.steer(c.me["x"]+(c.me["x"]-danger["x"]),
                                      c.me["y"]+(c.me["y"]-danger["y"])); continue

                if prof["target_food"]:
                    food = self._pick_food(c)
                    if food: await c.steer(food["x"], food["y"]); continue

                if target:
                    d = ((target["x"]-c.me["x"])**2+(target["y"]-c.me["y"])**2)**0.5
                    split = (c.me["size"] > target.get("size",0)*prof["split_size_mult"]
                             and d < max(c.me["size"],1.0)*prof["split_range_mult"])
                    eject = prof["eject_rate"] > 0 and d < c.me["size"]*2
                    await c.steer(target["x"], target["y"], want_split=split, want_eject=eject)
                else:
                    await c.steer(c.me["x"], c.me["y"], freeze=True)

