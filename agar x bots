import aiohttp

async def find_server(mode="ffa"):
    async with aiohttp.ClientSession() as s:
        async with s.post("https://m.agar.io/findServer", data=f"{mode}\n",
                          headers={"User-Agent":"Mozilla/5.0"}) as r:
            text = (await r.text()).strip()
    parts = text.split("\n")
    host = parts[0]; key = parts[1] if len(parts) > 1 else ""
    return f"wss://{host}", key

async def find_server_retry(mode="ffa", tries=3):
    last = None
    for _ in range(tries):
        try: return await find_server(mode)
        except Exception as e: last = e
    raise RuntimeError(f"findServer failed: {last}")

async def resolve_uri(source: str):
    if not source or source == "ffa":
        return await find_server_retry("ffa")
    if source.startswith("party:"):
        from party import party_server
        return await party_server(source.split(":",1)[1].strip(), "ffa")
    if source.startswith("ws://") or source.startswith("wss://"):
        return source, ""
    raise RuntimeError(f"unknown source: {source}")
